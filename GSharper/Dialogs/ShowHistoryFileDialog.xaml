<ui:DialogWindow
    x:Class="GSharper.Dialogs.ShowHistoryFileDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:GSharper.Dialogs"
    xmlns:ui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:controlss="clr-namespace:GSharper.Controls"
    mc:Ignorable="d"
    Background="#323232"
    Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
    Title="История изменения файла в Git" 
    WindowStyle="ToolWindow" 
    ShowInTaskbar="False"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="250" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ProgressBar 
            Grid.Row="0"
            IsIndeterminate="True" 
            Name="_progressBarFilter" 
            Height="2px"
            Visibility="Collapsed" />
        <TextBlock
            Grid.Row="0"
            TextWrapping="Wrap" 
            TextAlignment="Left" 
            Name="_textBlockInfo"
            Visibility="Collapsed"
            Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
        />

        <TextBlock
            Grid.Row="1"
            TextAlignment="Left" 
            Text="До изменений"
            Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
        />

        <TextBlock
            Grid.Row="1"
            TextAlignment="Right" 
            Text="После"
            Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
        />

        <controlss:MonacoEditorControl Grid.Row="2" x:Name="_monacoEditorControl">

        </controlss:MonacoEditorControl>

        <DataGrid 
            Grid.Row="3"
            HeadersVisibility="Column"
            RowHeaderWidth="0"
            Name="_dataGridCommits" 
            AutoGenerateColumns="False" 
            CanUserAddRows="False"
            Background="#1E1E1E" 
            SelectionMode="Single"
            SelectionChanged="OnSelectedCommit"
            >
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#323232" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Padding" Value="10,0,0,0" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                    <Setter Property="BorderBrush" Value="#3F3F46" />
                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="#1E1E1E" />
                    <Setter Property="Foreground" Value="#F1F1F1" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2B2B2C" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3F3F46" />
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="#F1F1F1" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Commit" Binding="{Binding Commit}" Width="250" />
                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="200" />
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="150" />
                <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</ui:DialogWindow>
