<UserControl 
    x:Class="GSharper.Controls.ListItemSymbolControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:GSharper.Controls"
    mc:Ignorable="d" 
    d:DesignHeight="450"
    d:DesignWidth="800">
    <Grid Name="_grid">
        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Padding="2" Grid.Column="0" Grid.Row="0">
            <Image 
                Name="_imageElement"
                Stretch="None"
                RenderOptions.BitmapScalingMode="NearestNeighbor"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True"
                RenderOptions.EdgeMode="Aliased"
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch"></Image>
        </Border>
        <TextBlock Padding="0 2 0 0" Grid.Column="1" Grid.Row="0" Name="_textBlockName"></TextBlock>
        <TextBlock Padding="0 2 0 0" Grid.Column="2" Grid.Row="0" Name="_textBlockAssembly"></TextBlock>
    </Grid>
</UserControl>
