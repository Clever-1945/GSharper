<UserControl
    x:Class="GSharper.Controls.QuickInfoBlockControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:GSharper.Controls"
    xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
    mc:Ignorable="d"
    Background="#323232"
    Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
    d:DesignHeight="450" 
    d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.DockTargetButtonBackgroundBeginKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.DockTargetButtonBorderKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#323232" >
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ContextMenu}">
            <!-- Фон меню в редакторе -->
            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMenuBorderKey}}"/>
            <!-- Граница меню в редакторе -->
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMenuBorderKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="1,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. Стиль для пунктов меню (MenuItem) -->
        <Style TargetType="{x:Type MenuItem}">
            <!-- Цвет текста в редакторе -->
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarTextSelectedKey}}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <!-- Оболочка строки -->
                        <Border x:Name="CommandRow" 
                            Background="Transparent" 
                            BorderBrush="Transparent" 
                            BorderThickness="1"
                            SnapsToDevicePixels="True"
                            Margin="1,0">

                            <Grid MinHeight="24">
                                <Grid.ColumnDefinitions>
                                    <!-- Родная ширина колонки иконок в VS -->
                                    <ColumnDefinition Width="28" SharedSizeGroup="MenuItemIconColumnGroup"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Та самая левая полоса: красится в цвет подложки иконок редактора -->
                                <!--Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMenuIconBackgroundKey}}"-->
                                <Border x:Name="IconBar" 
                                    Grid.Column="0" 
                                    
                                    SnapsToDevicePixels="True">
                                    <ContentPresenter x:Name="Icon" 
                                                  ContentSource="Icon" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"
                                                  Width="16" Height="16"/>
                                </Border>

                                <!-- Контейнер для текста -->
                                <ContentPresenter Grid.Column="1" 
                                              ContentSource="Header" 
                                              Margin="9,2,16,2" 
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Триггеры изменения состояния (Hover / Наведение) -->
                        <ControlTemplate.Triggers>
                            <!-- Эффект наведения точно как в редакторе VS -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <!-- Подсветка строки -->
                                <Setter TargetName="CommandRow" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMouseOverBackgroundMiddle2Key}}"/>
                                <Setter TargetName="CommandRow" Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMouseOverBackgroundMiddle2Key}}"/>
                                <!-- При наведении полоса иконок становится прозрачной, чтобы плашка была сплошной -->
                                <Setter TargetName="IconBar" Property="Background" Value="Transparent"/>
                                <!-- Цвет текста при наведении -->
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarTextHoverKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Блок с названием Символа -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button 
                Grid.Row="0"
                Grid.Column="0"
                Click="OnClickSymbolName">
                <Image 
                    Name="_imageSymbolName"
                    Stretch="None"
                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    RenderOptions.EdgeMode="Aliased"
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch"></Image>
            </Button>

            <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                Padding="5 2 5 0"
                Background="Transparent"
                Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                Name="_textBlockSymbolName"
            ></TextBlock>

            <Image 
                Name="_imageError"
                Grid.Row="1"
                Grid.Column="0"
                Stretch="None"
                RenderOptions.BitmapScalingMode="NearestNeighbor"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True"
                RenderOptions.EdgeMode="Aliased"
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch"
                Visibility="Collapsed"></Image>

            <TextBox
                Name="_textBoxError"
                Grid.Row="1"
                Grid.Column="1"
                IsReadOnly="True"
                TextWrapping="Wrap"
                AcceptsReturn="True" 
                Focusable="True"
                Visibility="Collapsed"
                Background="Transparent"
                Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                BorderThickness="0"
                ></TextBox>

            <Image 
                Name="_imageWarning"
                Grid.Row="2"
                Grid.Column="0"
                Stretch="None"
                RenderOptions.BitmapScalingMode="NearestNeighbor"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True"
                RenderOptions.EdgeMode="Aliased"
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch"
                Visibility="Collapsed"></Image>

            <TextBox
                Name="_textBoxWarning"
                Grid.Row="2"
                Grid.Column="1"
                IsReadOnly="True"
                TextWrapping="Wrap"
                AcceptsReturn="True" 
                Focusable="True"
                Visibility="Collapsed"
                Background="Transparent"
                Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                BorderThickness="0"
            ></TextBox>

        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Padding="3"
                Background="Transparent"
                Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                Visibility="Collapsed"
                Name="_textBlockSummary"
            ></TextBlock>
        </Grid>
    </Grid>
</UserControl>
